<Slide style={{ width: 1280, height: 720, padding: '60px 60px', background: '#FFFFFF', position: 'relative' }}>
  {/* 标题区 */}
  <Box style={{ marginBottom: 40 }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.2 }}>目录</Text>
    <Box style={{ width: '100%', height: 2, background: '#1E4FA8', marginTop: 12 }} />
  </Box>

  {/* 三个章节 */}
  <Box style={{ flexDirection: 'column', gap: 28 }}>
    {[
      { num: '01', cn: '项目复现', en: 'Project Reproduction', desc: '超声 DL 重建最小闭环：DAS → 配对 → UNet → 指标验证' },
      { num: '02', cn: '论文对照', en: 'Paper Comparison', desc: 'Perdios 2021 论文要点与我方方法的对应关系' },
      { num: '03', cn: '论文启发', en: 'Inspiration & Next Step', desc: '角度稀疏采样消融 —— 创新点的下一步工作' },
    ].map((item) => (
      <Box key={item.num} style={{ flexDirection: 'row', alignItems: 'center', gap: 28, padding: '20px 24px', border: '1px solid #D6DCE5', borderRadius: 8 }}>
        <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#1E4FA8', width: 100, textAlign: 'center' }}>{item.num}</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.3 }}>
            {item.cn} <span style={{ fontSize: 18, color: '#8B97A8', fontWeight: 'normal' }}>{item.en}</span>
          </Text>
          <Text style={{ fontSize: 18, color: '#4A5568', marginTop: 6, lineHeight: 1.5 }}>{item.desc}</Text>
        </Box>
      </Box>
    ))}
  </Box>
</Slide>