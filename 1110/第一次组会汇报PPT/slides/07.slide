<Slide style={{ width: 1280, height: 720, padding: '60px 60px', background: '#FFFFFF' }}>
  <Box style={{ marginBottom: 16 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF', background: '#1E4FA8', padding: '10px 20px', borderRadius: 4, display: 'inline-block' }}>01 · 结果 —— PICMUS 公开数据整图重建</Text>
  </Box>

  {/* 核心成果图 */}
  <Box style={{ width: '100%', height: 360, marginBottom: 16, borderRadius: 8, overflow: 'hidden' }}>
    <Image src="assets/picmus_result.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
  </Box>

  {/* 指标三联数 */}
  <Box style={{ flexDirection: 'row', gap: 24, marginBottom: 16 }}>
    <Box style={{ flex: 1, borderTop: '3px solid #1E4FA8', paddingTop: 12 }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E4FA8' }}>+10.30 dB</Text>
      <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 2 }}>PSNR 提升（49.85 → 60.15）</Text>
    </Box>
    <Box style={{ flex: 1, borderTop: '3px solid #1E4FA8', paddingTop: 12 }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E4FA8' }}>0.9936</Text>
      <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 2 }}>SSIM（0.9350 → 0.9936）</Text>
    </Box>
    <Box style={{ flex: 1, borderTop: '3px solid #1E4FA8', paddingTop: 12 }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E4FA8' }}>187 对</Text>
      <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 2 }}>64×64 patch 训练样本</Text>
    </Box>
  </Box>

  {/* 结论条 */}
  <Box style={{ background: '#E8EFF8', borderRadius: 6, padding: '12px 18px' }}>
    <Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.5 }}>
      <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>结论</span>：DL 重建图点目标清晰、背景干净、伪影大幅减少，逼近 75 角度复合的高质图 —— 方法在真实公开数据上同样成立。
    </Text>
  </Box>
</Slide>